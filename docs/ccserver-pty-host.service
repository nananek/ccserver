[Unit]
Description=ccserver pty-host — persistent PTY session daemon (withdrawn feature, opt-in only: not used unless ccserver.service sets CCSERVER_PTY_HOST=1, see docs-site deployment/systemd.md section 6)
After=network.target

[Service]
Type=simple
WorkingDirectory=/path/to/ccserver
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/pty-host/index.js
Restart=on-failure
RestartSec=5
KillMode=process

[Install]
WantedBy=default.target
