[Unit]
Description=ccserver — Context & Coordination Server
After=network.target ccserver-pty-host.service
Wants=ccserver-pty-host.service

[Service]
Type=simple
WorkingDirectory=/path/to/ccserver
Environment=NODE_ENV=production
Environment=PORT=3001
# pty-host separation (keeps terminal sessions alive across `systemctl
# --user restart ccserver`, see docs-site deployment/systemd.md) is enabled
# by default as of Issue #119 Step7 -- no line needed here to turn it on.
# ccserver probes pty-host's reachability once at boot and automatically
# falls back to spawning ptys directly (the pre-Step7 behavior) if
# ccserver-pty-host.service (docs/ccserver-pty-host.service) isn't up yet.
# Uncomment to opt out entirely instead -- e.g. to silence that fallback
# warning, or to roll back after an upgrade:
# Environment=CCSERVER_PTY_HOST=0
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
